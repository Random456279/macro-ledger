{
  "name": "macro-ledger",
  "version": "0.7.0",
  "private": true,
  "description": "Macro Ledger: an iPhone macro and nutrient tracker published as a claude.ai artifact.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node test/smoke.cjs",
    "shots": "node tools/build.mjs && python3 test/shots.py",
    "build:standalone": "node tools/build.mjs --standalone",
    "test:standalone": "python3 test/standalone.py",
    "setup": "node tools/setup.mjs",
    "deploy": "node tools/setup.mjs --deploy",
    "dev": "node tools/build.mjs --standalone && wrangler dev --local --var AI_STUB:1"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "jsdom": "24.1.0",
    "wrangler": "^4.42.0"
  }
}
